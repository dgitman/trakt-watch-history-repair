{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "trakt-list-sync",
  "account_id": "d438b29f07b69b1768b27194151306df",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-20",
  "compatibility_flags": ["nodejs_compat"],
  "preview_urls": false,
  "durable_objects": {
    "bindings": [
      {
        "name": "SYNC",
        "class_name": "DavEmalieSync",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DavEmalieSync"],
    },
  ],
  "triggers": {
    "crons": ["35 12 * * *"],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "secrets": {
    "required": [
      "ADMIN_KEY",
      "ENCRYPTION_KEY",
      "TRAKT_CLIENT_ID",
    ],
  },
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["david@because.ventures"],
    },
  ],
  "vars": {
    "ALERT_TO": "david@because.ventures",
    "ALERT_FROM": "trakt-sync@gitman.net",
  },
}

